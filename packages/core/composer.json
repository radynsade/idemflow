{
    "name": "radynsade/idemflow-core",
    "description": "Framework-agnostic durable idempotency engine for PHP",
    "type": "library",
    "require": {
        "php": "^8.4",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "IdemFlow\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IdemFlow\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration=phpunit.xml.dist"
    },
    "authors": [
        {
            "name": "Nikita Prokopenko",
            "email": "radynje@gmail.com"
        }
    ]
}
