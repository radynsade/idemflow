{
    "name": "radynsade/idemflow-core",
    "description": "Framework-agnostic durable idempotency engine for PHP",
    "keywords": [
        "idempotency",
        "idempotent",
        "atomic",
        "atomicity",
        "retries"
    ],
    "homepage": "https://github.com/radynsade/idemflow",
    "support": {
        "issues": "https://github.com/radynsade/idemflow/issues",
        "source": "https://github.com/radynsade/idemflow"
    },
    "authors": [
        {
            "name": "Nikita Prokopenko",
            "email": "radynje@gmail.com"
        }
    ],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.4",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13"
    },
    "autoload": {
        "psr-4": {
            "IdemFlow\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IdemFlow\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration=phpunit.xml.dist"
    }
}
